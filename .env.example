UNSTRUCTURED_API_KEY=your_unstructured_api_key
# Optional. Defaults to https://transform.unstructured.io/api/v2
# A legacy api.unstructuredapp.io URL is treated as that default.
# UNSTRUCTURED_API_URL=https://transform.unstructured.io/api/v2

# Optional. "true" returns sample results and skips the live API, including in production.
# UNSTRUCTURED_USE_FIXTURES=true
