UNSTRUCTURED_API_KEY=your_unstructured_api_key
# Host only, or the full /general/v0/general URL. Both are accepted.
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io

# Optional. Server-only. "true" selects the Hi-Res strategy. Callers cannot enable this.
# UNSTRUCTURED_HI_RES=true

# Optional. "true" returns sample results and skips the live API, including in production.
# UNSTRUCTURED_USE_FIXTURES=true
